.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version.
#   Reference: https://github.com/pyenv/pyenv/blob/master/COMMANDS.md#pyenv-version-file
#.python-version

# pipenv
#   According to pypa/pipenv#1053, pypa/pipenv#1162 and pypa/pipenv#1257
#   Pipfile.lock contains global, local and developer-specific info.
#   It's not recommended to check in Pipfile.lock if it's a library.
#   For apps, it should be checked in.
#Pipfile.lock

# poetry
#   Similarly, poetry.lock contains developer-specific env info and paths,
#   but it's recommended to check in poetry.lock for applications.
#poetry.lock

# pdm
#   Similar to Pipfile.lock / poetry.lock, pdm.lock contains global, local and developer-specific info
#pdm.lock

# PEP 582; used by e.g. github.com/lincolnloop/layman and pdm
__pypackages__/

